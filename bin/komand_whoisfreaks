                connection=connection.Connection()
            )
            self.add_trigger(triggers.NewlyRegisteredDomains())
        
            self.add_trigger(triggers.ThreatFeed())
        
            self.add_action(actions.LiveWhois())
        
            self.add_action(actions.HistoricalWhois())
        
            self.add_action(actions.ReverseWhois())
        
            self.add_action(actions.DnsLookup())
        
            self.add_action(actions.IpWhois())
        
